# PostgreSQL. En Railway se completa sola con ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://usuario:clave@host:5432/railway"

# Auth.js: clave aleatoria para firmar sesiones. Generala con: npx auth secret
AUTH_SECRET=""

# Resend (envío del link de acceso al panel y, en la etapa 5, avisos de leads). https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Remitente. Sin dominio verificado en Resend usá onboarding@resend.dev (solo envía al email de tu cuenta de Resend).
EMAIL_FROM="Eco Lógica <onboarding@resend.dev>"

# Emails con acceso de administrador, separados por coma. Después se agregan más desde /admin/usuarios.
ADMIN_EMAILS=""
