# MySQL. En Hostinger: mysql://USUARIO:CONTRASEÑA@localhost:3306/BASE (codificá en la URL los caracteres especiales de la contraseña).
DATABASE_URL="mysql://usuario:clave@localhost:3306/base"

# Auth.js: clave aleatoria para firmar sesiones.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Dirección pública del sitio (sin barra final). Se usa para armar el link de acceso al panel.
AUTH_URL="https://xxxx.hostingersite.com"
NEXT_PUBLIC_SITE_URL="https://xxxx.hostingersite.com"

# Resend (envío del link de acceso al panel). https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Remitente. Sin dominio verificado en Resend usá onboarding@resend.dev (solo envía al email de tu cuenta de Resend).
EMAIL_FROM="Eco Lógica <onboarding@resend.dev>"

# Emails con acceso de administrador, separados por coma. Después se agregan más desde /admin/usuarios.
ADMIN_EMAILS=""
